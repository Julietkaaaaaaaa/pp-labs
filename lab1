struct someData {
    std::string name;
    std::string surname;
    std::string address;
    int age = 0;

    void print() const {
        std::cout << name << " " << surname << " (" << address << ", вік: " << age << ")\n";
    }
};

class exchangePerson {
public:
    someData data;
    std::mutex mtx; 

    static void JohnDoe(exchangePerson& person) {
        std::lock_guard<std::mutex> lock(person.mtx);
        person.data.name = "John";
        person.data.surname = "Doe";
        person.data.address = "Unknown";
        person.data.age = 120;
    }

    static void JacobSmith(exchangePerson& person) {
        std::lock_guard<std::mutex> lock(person.mtx);
        person.data.name = "Jacob";
        person.data.surname = "Smith";
        person.data.address = "Known";
        person.data.age = 1;
    }

    static void Swap(exchangePerson& p1, exchangePerson& p2) {
        if (&p1 == &p2) {
            std::cout << "(Swap) Спроба обміну об'єкта сам із собою скасована.\n";
            return;
        }

        std::lock(p1.mtx, p2.mtx);

        std::lock_guard<std::mutex> lock1(p1.mtx, std::adopt_lock);
        std::lock_guard<std::mutex> lock2(p2.mtx, std::adopt_lock);

        std::cout << "\nДо обміну\n";
        std::cout << "Об'єкт 1: "; p1.data.print();
        std::cout << "Об'єкт 2: "; p2.data.print();

        std::swap(p1.data, p2.data);

        std::cout << "\nПісля обміну\n";
        std::cout << "Об'єкт 1: "; p1.data.print();
        std::cout << "Об'єкт 2: "; p2.data.print();
    }
};

int main() {
    std::cout << "Завдання 1.2.6\n";

    exchangePerson ep1;
    exchangePerson ep2;

    std::thread t1(exchangePerson::JohnDoe, std::ref(ep1));
    std::thread t2(exchangePerson::JacobSmith, std::ref(ep2));

    t1.detach();
    t2.detach();

    std::this_thread::sleep_for(std::chrono::milliseconds(50));

    std::thread t_swap(exchangePerson::Swap, std::ref(ep1), std::ref(ep2));

    t_swap.join();

    return 0;
}



