std::list<int> l;

void AddToList(int startVal) {
    for (int i = 0; i < 10; ++i) {
        int valToAdd = startVal + i;
        l.push_back(valToAdd); 

        std::string msg = "(AddToList) Додано елемент: " + std::to_string(valToAdd) + "\n";
        std::cout << msg; 
    }
}

void ListContains(int searchVal) {
    for (int i = 0; i < 10; ++i) {
        bool found = (std::find(l.begin(), l.end(), searchVal) != l.end());

        std::string msg = "(ListContains) Спроба " + std::to_string(i + 1) + 
                          ": Елемент " + std::to_string(searchVal) + 
                          (found ? " входить\n" : " не входить\n");
        std::cout << msg; 
    }
}

int main() {
    int startVal = 42;

    std::thread t1(AddToList, startVal);
    std::thread t2(ListContains, startVal);

    t1.join();
    t2.join();

    return 0;
}



