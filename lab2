#include <iostream>
#include <thread>
#include <future>
#include <chrono>
#include <cmath>
#include <Windows.h>

long long getNthPrime(int n) {
    if (n <= 0) return 0;
    int count = 0;
    long long num = 1;
    while (count < n) {
        num++;
        bool prime = true;
        for (long long i = 2; i * i <= num; ++i) {
            if (num % i == 0) {
                prime = false;
                break;
            }
        }
        if (prime) {
            count++;
        }
    }
    return num;
}

// Перший потік
void Thread1Func(int n, std::promise<long long> prom1, std::promise<bool> promSignal, std::promise<long long> prom2) {
    long long prime1 = getNthPrime(n);
    prom1.set_value(prime1); // Передача n-го простого числа

    promSignal.set_value(true); // Сигнал для другого потоку

    long long prime2 = getNthPrime(n * 10);
    prom2.set_value(prime2); // Передача (n*10)-го простого числа
}

// Другий потік
void Thread2Func(int n, std::future<bool> futSignal) {
    bool signal = futSignal.get(); // Очікування сигналу від першого потоку
    if (signal) {
        std::this_thread::sleep_for(std::chrono::seconds(2));
        std::cout << "Корінь з n (sqrt(" << n << ")): " << std::sqrt(n) << "\n";
    }
}

int main() {

    SetConsoleCP(1251);
    SetConsoleOutputCP(1251);

    int n;
    std::cout << "Введіть n (номер простого числа): ";
    if (!(std::cin >> n) || n <= 0) return 0;

    std::promise<long long> prom1;
    std::promise<bool> promSignal;
    std::promise<long long> prom2;

    std::future<long long> fut1 = prom1.get_future();
    std::future<bool> futSignal = promSignal.get_future();
    std::future<long long> fut2 = prom2.get_future();

    std::thread t1(Thread1Func, n, std::move(prom1), std::move(promSignal), std::move(prom2));
    std::thread t2(Thread2Func, n, std::move(futSignal));

    std::cout << n << "-е просте число: " << fut1.get() << "\n";
    std::cout << (n * 10) << "-е просте число: " << fut2.get() << "\n";

    t1.join();
    t2.join();

    return 0;
}
